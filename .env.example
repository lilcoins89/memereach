# Runtime
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Helius credentials. Never prefix with NEXT_PUBLIC_.
HELIUS_API_KEY=
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=

# Production persistence/auth placeholders. Demo mode stays active when unset.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production event signing secret. Do not commit a real value.
MEMEREACH_EVENT_SIGNING_SECRET=
MEMEREACH_PLACEMENT_TOKEN_SECRET=
