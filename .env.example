# Runtime
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data source mode. Demo is safe for testing; switch to mainnet in the UI or set this default.
MEMEREACH_DATA_MODE=demo
NEXT_PUBLIC_DATA_MODE=demo

# Server-only Helius credentials. Never prefix with NEXT_PUBLIC_.
# Mainnet live mode uses Helius SDK DAS screening and Helius RPC when this is set.
HELIUS_API_KEY=
SOLANA_CLUSTER=mainnet-beta
# Optional custom mainnet RPC URL. Keep it server-only.
SOLANA_RPC_URL=

# Production persistence/auth placeholders. Demo mode stays active when unset.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production event signing secret. Do not commit a real value.
MEMEREACH_EVENT_SIGNING_SECRET=
MEMEREACH_PLACEMENT_TOKEN_SECRET=
